plugin_add bitr0t.system-monitor https://github.com/rmacy/omarchy-system-monitor.git
bar_put bitr0t.system-monitor --after omarchy.workspaces
bar_set bitr0t.system-monitor chipMode minimal

# CPU temperature sensor: k10temp on AMD, coretemp on Intel.
sensor=$(sensors -j 2>/dev/null | jq -r '
  to_entries[] | .key as $chip | .value | to_entries[]
  | select(($chip | startswith("k10temp")) and .key == "Tctl"
        or ($chip | startswith("coretemp")) and .key == "Package id 0")
  | "sensor:temperature:\($chip):\(.key):temp1_input"' | head -1)
if [[ -n $sensor ]]; then
  bar_set bitr0t.system-monitor monitors "[\"cpu\",\"$sensor\"]" --json
else
  bar_set bitr0t.system-monitor monitors '["cpu"]' --json
fi
