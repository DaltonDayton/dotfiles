#!/bin/bash
# Start TradeSkillMaster's desktop app in the Battle.net prefix, then Battle.net.
# Omarchy's launcher is a plain umu-run call, so TSM just reuses its env.
# The guard matches the Wine-side path (backslashes) rather than the umu-run
# command line: umu-run lingers after TSM quits, and matching it would skip
# every relaunch.
set -e
PREFIX="$HOME/Games/battlenet"
TSM="$PREFIX/drive_c/Program Files (x86)/TradeSkillMaster Application/app/TSMApplication.exe"
if [[ -f $TSM ]] && ! pgrep -f '\\TSMApplication\.exe' >/dev/null; then
  env WINEPREFIX="$PREFIX" PROTONPATH=GE-Proton GAMEID=umu-battlenet PROTON_VERB=run \
    setsid -f umu-run "$TSM" >/dev/null 2>&1
fi
exec omarchy-launch-battlenet "$@"
