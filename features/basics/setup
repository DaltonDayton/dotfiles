# git: personal settings via [include]
ensure_block ~/.config/git/config "[include]" "	path = $FEATURE/personal"

# bash: aliases and sdev
ensure_line ~/.bashrc "source $FEATURE/bashrc"

# Claude as the default coding agent
[[ $(cat ~/.config/omarchy/defaults/agent 2>/dev/null) == claude ]] || run omarchy default agent claude

# idle goes straight to lock
[[ -e ~/.local/state/omarchy/toggles/screensaver-off ]] || run omarchy toggle screensaver-off on

# after omarchy update: notify when a review is due (version bump, snapshot or watched
# stock file changed); the check also raises the marker the bashrc nags about
old_hook=~/.config/omarchy/hooks/post-update.d/omarchy-diff.hook
[[ -e $old_hook ]] && run rm "$old_hook"
hook=~/.config/omarchy/hooks/post-update.d/omarchy-review.hook
tmp=$(mktemp -d)/omarchy-review.hook
printf '#!/bin/bash\n# Installed by the dotfiles basics feature.\nwhy=$(%q/omarchy-review --check 2>&1) || notify-send "Omarchy review due" "$why"\nexit 0\n' "$REPO" > "$tmp"
cmp -s "$tmp" "$hook" || run omarchy hook install post-update "$tmp"
rm -r "${tmp%/*}"
