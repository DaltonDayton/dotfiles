ensure_line ~/.bashrc "source $FEATURE/bash/rc"

# Ubuntu renames these to avoid clashes; the configs and aliases expect the
# upstream names.
mkdir -p ~/.local/bin
[[ -e ~/.local/bin/bat || -L ~/.local/bin/bat ]] || run ln -s /usr/bin/batcat ~/.local/bin/bat
[[ -e ~/.local/bin/fd || -L ~/.local/bin/fd ]] || run ln -s /usr/bin/fdfind ~/.local/bin/fd

(( CHANGED )) && [[ ! -f ~/.config/git/config.local ]] && say "note: create ~/.config/git/config.local with [user] name/email (and signing) for this machine"
