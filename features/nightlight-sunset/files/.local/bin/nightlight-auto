#!/usr/bin/python3
"""Turn Omarchy's night light on at sunset and off at sunrise.

hyprsunset only knows fixed clock-time profiles, so this computes today's
sunrise/sunset (NOAA approximation, a couple of minutes off at worst), applies
the matching state the same way omarchy-toggle-nightlight does, and books a
one-shot systemd user timer for the next transition. Run once at login from
autostart.lua; every run re-arms the next one. Manual toggles in between are
left alone until the next sunrise/sunset.

    nightlight-auto          apply now and schedule the next transition
    nightlight-auto --dry    print what it would do, touch nothing
"""
import math
import os
import subprocess
import sys
import time
from datetime import date, datetime, timedelta, timezone

# Clinton, UT
LAT = 41.14
LON = -112.05

# Keep in sync with omarchy-toggle-nightlight and the shell's nightlight service.
NIGHT_TEMP = 4000
DAY_TEMP = 6500

UNIT_PREFIX = "nightlight-auto-"
J2000 = datetime(2000, 1, 1, 12, tzinfo=timezone.utc)


def sun_times(day: date, lat: float, lon: float, tz) -> tuple[datetime, datetime]:
    """(sunrise, sunset) for the given local date, as aware datetimes in tz."""
    noon = datetime(day.year, day.month, day.day, 12, tzinfo=tz)
    n = round((noon - J2000) / timedelta(days=1) + 0.0008)
    j_star = n - lon / 360
    m = math.radians((357.5291 + 0.98560028 * j_star) % 360)
    c = 1.9148 * math.sin(m) + 0.02 * math.sin(2 * m) + 0.0003 * math.sin(3 * m)
    lam = math.radians((math.degrees(m) + c + 180 + 102.9372) % 360)
    j_transit = j_star + 0.0053 * math.sin(m) - 0.0069 * math.sin(2 * lam)
    decl = math.asin(math.sin(lam) * math.sin(math.radians(23.4397)))
    phi = math.radians(lat)
    cos_omega = (math.sin(math.radians(-0.833)) - math.sin(phi) * math.sin(decl)) / (math.cos(phi) * math.cos(decl))
    if not -1 <= cos_omega <= 1:
        raise ValueError(f"sun never rises or never sets on {day} at lat {lat}")
    omega = math.degrees(math.acos(cos_omega)) / 360
    rise = J2000 + timedelta(days=j_transit - omega)
    set_ = J2000 + timedelta(days=j_transit + omega)
    return rise.astimezone(tz), set_.astimezone(tz)


def decide(now: datetime, lat: float, lon: float) -> tuple[bool, datetime]:
    """(is it night, when the next sunrise/sunset happens)."""
    rise, set_ = sun_times(now.date(), lat, lon, now.tzinfo)
    if now < rise:
        return True, rise
    if now < set_:
        return False, set_
    return True, sun_times(now.date() + timedelta(days=1), lat, lon, now.tzinfo)[0]


def current_temp() -> int | None:
    out = subprocess.run(["hyprctl", "hyprsunset", "temperature"], capture_output=True, text=True)
    digits = "".join(ch for ch in out.stdout if ch.isdigit())
    return int(digits) if out.returncode == 0 and digits else None


def apply(night: bool) -> None:
    temp = NIGHT_TEMP if night else DAY_TEMP
    if subprocess.run(["pgrep", "-x", "hyprsunset"], capture_output=True).returncode != 0:
        subprocess.Popen(["uwsm-app", "--", "hyprsunset"], start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    # A freshly started hyprsunset applies its profile at the end of boot,
    # overriding anything sent before then, so resend until it sticks.
    for _ in range(10):
        subprocess.run(["hyprctl", "hyprsunset", "temperature", str(temp)], capture_output=True)
        time.sleep(0.2)
        if current_temp() == temp:
            break
    else:
        sys.exit(f"hyprsunset never reported {temp}K (got {current_temp()})")
    # The bar chip only re-reads state when asked. Best effort: at login the
    # shell may not be up yet, and it reads the right state itself when it is.
    subprocess.run(["omarchy-shell", "-q", "nightlight", "refresh"], capture_output=True)


def schedule(when: datetime) -> None:
    # One transient timer per transition, named by its time. The timer that
    # fired us is <prefix><now>.timer, and its .service is what we're running
    # in, so re-using one fixed name would collide with ourselves.
    pending = subprocess.run(
        ["systemctl", "--user", "list-units", "--plain", "--no-legend", f"{UNIT_PREFIX}*.timer"],
        capture_output=True, text=True).stdout.split()
    for unit in (u for u in pending if u.endswith(".timer")):
        subprocess.run(["systemctl", "--user", "stop", unit], capture_output=True)
    subprocess.run([
        "systemd-run", "--user", "--quiet", "--collect",
        f"--unit={UNIT_PREFIX}{when:%Y%m%d-%H%M}",
        "--timer-property=AccuracySec=10s",
        f"--on-calendar={when:%Y-%m-%d %H:%M:%S}",
        os.path.abspath(sys.argv[0]),
    ], check=True)


def main() -> None:
    dry = "--dry" in sys.argv[1:]
    now = datetime.now().astimezone()
    night, nxt = decide(now, LAT, LON)
    state = "on" if night else "off"
    print(f"night light {state}; next transition {nxt:%Y-%m-%d %H:%M %Z}")
    if dry:
        return
    apply(night)
    schedule(nxt)


if __name__ == "__main__":
    main()
