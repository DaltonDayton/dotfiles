#!/usr/bin/env bash
# What did Omarchy change in the snapshot configs since the last sync?
#   ./omarchy-diff           show upstream's changes (not yours)
#   ./omarchy-diff --merge   3-way merge them into every feature's copy, then record the new baseline
#
# upstream/<path> holds Omarchy's config/<path> as of the last sync; the copies
# are features/*/files/.config/<path>.
set -euo pipefail
repo=$(cd "$(dirname "$0")" && pwd)
omarchy=/usr/share/omarchy/config

cd "$repo/upstream"
find . -type f | sed 's|^\./||' | sort | while read -r f; do
  new="$omarchy/$f"
  [[ -e $new ]] || { echo "gone upstream: $f"; continue; }
  cmp -s "$f" "$new" && continue

  if [[ ${1:-} == --merge ]]; then
    for mine in "$repo"/features/*/files/.config/"$f"; do
      [[ -e $mine ]] || continue
      if git merge-file "$mine" "$f" "$new"; then
        echo "merged    ${mine#"$repo"/}"
      else
        echo "CONFLICT  ${mine#"$repo"/}  (resolve the <<<<<<< markers)"
      fi
    done
    cp "$new" "$f"
  else
    echo "== $f"; diff -u "$f" "$new" || true
  fi
done
