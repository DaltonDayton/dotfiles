#!/usr/bin/env bash
# What did Omarchy change in the files this repo snapshots?
#   ./omarchy-diff                 show upstream's changes since the last sync
#   ./omarchy-diff --merge         per file: merge it in, keep mine, or decide later
#   ./omarchy-diff --merge --all   merge everything without asking
#
# A feature declares its snapshots in `upstream`, one per line:
#   <path under files/> <TAB> <path under /usr/share/omarchy/>
# upstream/<omarchy path> is Omarchy's copy as of the last sync: the base of
# the 3-way merge. A snapshot without a baseline gets one recorded on any run.
#
# While any snapshot differs, $STATE/omarchy-changed exists; the basics bashrc
# mentions it in every new shell, so a missed post-update notification isn't lost.
set -euo pipefail
repo=$(cd "$(dirname "$0")" && pwd)
omarchy=${OMARCHY_PATH:-/usr/share/omarchy}
marker=${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles/omarchy-changed

mode=show all=0
for arg in "$@"; do
  case $arg in
    --merge) mode=merge ;;
    --all) all=1 ;;
    *) echo "usage: omarchy-diff [--merge [--all]]" >&2; exit 1 ;;
  esac
done

# copies[<omarchy path>] = newline-separated "features/<f>/files/<path>" entries.
declare -A copies=()
for decl in "$repo"/features/*/upstream; do
  feature=$(basename "$(dirname "$decl")")
  while IFS=$'\t' read -r mine rel; do
    [[ -n $mine && -n $rel ]] || continue
    copies[$rel]+="features/$feature/files/$mine"$'\n'
  done < "$decl"
done

for rel in $(printf '%s\n' "${!copies[@]}" | sort); do
  base=$repo/upstream/$rel
  live=$omarchy/$rel
  [[ -e $live ]] || { echo "gone upstream: $rel"; continue; }
  if [[ ! -e $base ]]; then
    mkdir -p "${base%/*}"
    cp "$live" "$base"
    echo "baseline recorded: upstream/$rel"
    continue
  fi
  cmp -s "$base" "$live" && continue

  echo "== $rel"
  choice=merge
  if [[ $mode == show ]]; then
    diff -u "$base" "$live" || true
    continue
  elif (( ! all )); then
    diff -u "$base" "$live" || true
    choice=$(gum choose --header "Omarchy changed $rel" "merge" "keep mine" "later") || choice=later
  fi

  case $choice in
    merge)
      while read -r mine; do
        [[ -n $mine ]] || continue
        if git merge-file "$repo/$mine" "$base" "$live"; then
          echo "merged    $mine"
        else
          echo "CONFLICT  $mine  (resolve the <<<<<<< markers)"
        fi
      done <<<"${copies[$rel]}"
      cp "$live" "$base" ;;
    "keep mine")
      cp "$live" "$base"
      echo "kept mine, baseline advanced" ;;
    *)
      echo "left for later" ;;
  esac
done

# Marker reflects what is still out of sync after this run.
pending=0
for rel in "${!copies[@]}"; do
  [[ -e $omarchy/$rel && -e $repo/upstream/$rel ]] || continue
  cmp -s "$repo/upstream/$rel" "$omarchy/$rel" || pending=1
done
if (( pending )); then mkdir -p "${marker%/*}"; touch "$marker"; else rm -f "$marker"; fi
